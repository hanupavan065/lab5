my_find_sum <- function(x, find_sum) {
# Checking if x is a numeric vector
stopifnot(is.numeric(x), is.vector(x))
# Checking if find_sum is a numeric scalar
stopifnot(is.numeric(find_sum), length(find_sum) == 1)
# Initializing variables
total <- 0
i <- 1
# Keep adding until total is greater than find_sum
# or the vector has been traversed
while (total <= find_sum && i <= length(x)) {
total <- total + x[i]
i <- i + 1
}
return(total)
}
