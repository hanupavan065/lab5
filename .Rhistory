View(my_moving_median)
repeat_my_moving_median <- function(x, n, ...) {
# Checking if x is a numeric vector
stopifnot(is.numeric(x), is.vector(x))
# Checking if n is a numeric scalar
stopifnot(is.numeric(n), length(n) == 1)
# Creating an empty result vector
result <- numeric(length(x) - n)
# Initializing the index
t <- 1
repeat {
# Stop if the index is greater than the length of result vector
if (t > length(result)) {
break
}
# Calculating the rolling median
result[t] <- median(x[t:(t + n)], ...)
# increasing the index to move on
t <- t + 1
}
return(result)
}
repeat_my_moving_median(x = 1:10, n=2)
repeat_my_moving_median(x = 5:15, n=4)
repeat_my_moving_median(x = c(5,1,2,NA,2,5,6,8,9,9), n=2)
in_environment <- function(env) {
# Check that env is a text element
stopifnot(is.character(env), length(env) == 1)
# Get the environment
environment <- get(env)
# Return the contents as a text vector
return(ls(envir = environment))
}
