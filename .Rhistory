while_mult_table <- function(from, to) {
#checking if from and to are numeric scalars or not
if (!is.numeric(from) || length(from) != 1 || !is.numeric(to) || length(to) != 1) {
stop("Both 'from' and 'to' must be numeric scalars.")
}
#creating the sequence of numbers that should be multiplied
factors <- from:to
a <- length(factors)
#creating a empty matrix(size nXn) to store results
mat <- matrix(0, nrow = a, ncol = a)
#making the sequence of numbers as our rows and columns
rownames(mat) <- factors
colnames(mat) <- factors
# Initializing the row index for the outer while loop
i <- 1
# Outer while loop iterates over the rows
while (i <= a) {
# Initializing the column index for the inner while loop
j <- 1
# Inner while loop iterates over the columns
while (j <= a) {
# Calculate the product and place it in the correct cell of the matrix
mat[i, j] <- factors[i] * factors[j]
# increasing the column index to move to next column
j <- j + 1
}
#increasing the row index to move to next row
i <- i + 1
}
#returning the final output matrix
return(mat)
}
while_mult_table(from = 3, to = 5)
