my_find_sum <- function(x, find_sum) {
#checking if x ix a numeric vector
stopifnot(is.numeric(x), is.vector(x))
# Checking if find_sum is a numeric scalar
stopifnot(is.numeric(find_sum), length(find_sum) == 1)
# Initializing the variables
total <- 0
i <- 1
repeat {
# stop if i is greater than the length x
if (i > length(x)) {
break
}
# Add the current element
total <- total + x[i]
i <- i + 1
# Stop if sum is greater than find_sum
if (total > find_sum) {
break
}
}
return(total)
}
