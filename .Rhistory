cov <- function(X) {
# Assert that X is a data.frame
if (!is.data.frame(X)) {
stop("X must be a data.frame.")
}
# Use lapply with an anonymous function to calculate sd / mean for each column
res <- lapply(X, function(col) sd(col) / mean(col))
# Convert the resulting list into a vector
unlist(res)
}
data(iris)
cov(X = iris[1:4])
cov(X = iris[3:4])
