sheldon_game <- function(player1,player2){
choices<- c('rock','paper','scissors','lizard','spock')
if (!(player1 %in% choices) & !(player2 %in% choices)){
stop("invalid choice")
}
if (player1 == player2){
return("Draw!")
}
rules <- list(
rock     = c("scissors", "lizard"),
paper    = c("rock", "spock"),
scissors = c("paper", "lizard"),
lizard   = c("spock", "paper"),
spock    = c("scissors", "rock")
)
if (player2 %in% rules[[player1]]){
return("Player 1 wins!")
}
else{
return("Player 2 wins!")
}
}
my_moving_median <- function(x, n, ...) {
# Check that x is a numeric vector
stopifnot(is.numeric(x), is.vector(x))
# Check that n is a numeric scalar
stopifnot(is.numeric(n), length(n) == 1)
# Number of medians that can be calculated
result <- numeric(length(x) - n)
# Calculate the rolling median
for (t in 1:length(result)) {
result[t] <- median(x[t:(t + n)], ...)
}
return(result)
}
